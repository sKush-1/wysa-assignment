# PostgreSQL (used by docker-compose)
POSTGRES_USER=wysa
POSTGRES_PASSWORD=wysa_secret
POSTGRES_DB=wysa_db
POSTGRES_PORT=5432

# Prisma DATABASE_URL (used by the app)
DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public"

# Server & CORS
PORT=3000
NODE_ENV=development
# Comma-separated allowed origins in production (e.g. https://your-frontend.vercel.app,http://localhost:5173)
# In development, defaults to '*' if omitted
CORS_ORIGIN=http://localhost:5173
